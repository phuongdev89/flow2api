{
  "manifest_version": 3,
  "name": "Flow2API Captcha Worker",
  "version": "1.1.0",
  "description": "Generate Google Labs reCAPTCHA Enterprise tokens for Flow2API and push fresh Google cookies from this Chrome profile.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.google.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
